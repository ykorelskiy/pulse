# ==============================================================================
# PULSE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in the actual secret values.
# NEVER commit .env with secrets to git!

# App environment: development | staging | production
PULSE_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage (S3-compatible API)
# Obtain from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# ------------------------------------------------------------------------------
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=pulse-assets
R2_PUBLIC_DOMAIN=https://assets.pulse.art

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# Obtain from: BotFather on Telegram (@BotFather)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_CHAT_ID=123456789
CHANNEL_CHAT_ID=-1001234567890
DISCUSSION_GROUP_ID=-1009876543210

# ------------------------------------------------------------------------------
# Timezone Configuration
# Default timezone for scheduling and daily issues
# ------------------------------------------------------------------------------
TIMEZONE=Europe/Moscow
